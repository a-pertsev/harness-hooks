{
  "name": "otel",
  "inputs": {
    "email": {"ask": "Your work email"}
  },
  "settings": {
    "claude": {
      "env": {
        "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
        "OTEL_METRICS_EXPORTER": "otlp",
        "OTEL_LOGS_EXPORTER": "otlp",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "https://otel.example.com:4318",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
        "OTEL_RESOURCE_ATTRIBUTES": "user.email={email}"
      }
    },
    "codex": {
      "otel": {
        "exporter": {"otlp-http": {"endpoint": "https://otel.example.com:4318/v1/logs", "protocol": "binary"}},
        "metrics_exporter": {"otlp-http": {"endpoint": "https://otel.example.com:4318/v1/metrics", "protocol": "binary"}}
      }
    }
  }
}
